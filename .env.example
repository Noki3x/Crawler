# Where collected data is stored. SQLite works for local runs;
# docker-compose sets this to the bundled Postgres.
DATABASE_URL=sqlite:///crawler.db

# Optional. Raises CoinGecko rate limits (free "Demo" key from coingecko.com).
COINGECKO_API_KEY=

# How many top coins by market cap to snapshot each cycle.
COINGECKO_TOP_N=250

# Optional. Reddit only answers servers through its API. Create a "script" app at
# https://www.reddit.com/prefs/apps and paste its id and secret here to collect Reddit posts.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

LOG_LEVEL=INFO

# Used by docker-compose for the bundled Postgres.
POSTGRES_PASSWORD=change-me

# Claude reads and tags every item (major/minor, bullish/bearish, coins affected).
# Get a key at https://console.anthropic.com. Without it the classifier is skipped.
ANTHROPIC_API_KEY=
# claude-opus-5-5 is the most accurate. claude-haiku-5-5 is ~40x cheaper per token if cost matters.
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# Trending DEX tokens with less liquidity than this get a warning.
LOW_LIQUIDITY_USD=25000

# Password for the web terminal (any username). Required for `crawler serve`.
DASHBOARD_PASSWORD=

# Wallet tracking uses free public RPCs. Paste your own URLs here if they rate-limit you.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# ETHEREUM_RPC_URL=
# BASE_RPC_URL=
WALLET_MIN_MOVE_USD=5

# Signals: coins need this much 24h volume to be picked; DEX tokens need this much liquidity.
RUNNER_MIN_VOLUME=5000000
DEX_RUNNER_MIN_LIQUIDITY=100000
# The day's top-runner picks are pushed on the first signals run at or after this hour (UTC).
DAILY_PICKS_HOUR_UTC=12

# Phone alerts. Easiest: install the ntfy app, subscribe to a long random topic, put it here.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# Telegram channel: on the server, run `bash deploy/telegram.sh` to fill these in.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Alert kinds posted to Telegram whatever their severity: rug pulls (and possible ones), hacks, daily runners.
TELEGRAM_KINDS=rug_risk,hack,picks
# Which alerts get pushed: info | warn | critical. Daily picks and market-call flips always do.
NOTIFY_MIN_SEVERITY=critical
# Alert kinds pushed whatever their severity (comma-separated), e.g. wallet,rug_risk,low_liquidity
NOTIFY_KINDS=wallet
